  "item": [
    {
      "name": "1. POST valid product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"newProductId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"PVC Elbow 1 inch\",\n  \"category\": \"Plumbing\",\n  \"quantity\": 80,\n  \"unitPrice\": 45\n}"
        },
        "url": {
          "raw": "http://localhost:8085/api/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "products"]
        }
      }
    },
